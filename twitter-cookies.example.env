# Twitter authentication cookies for bird CLI
# Get these from browser DevTools > Application > Cookies > x.com
# Update weekly as they expire
#
# Usage: Copy this file to twitter-cookies.env and fill in your values
# Then mount it when running Docker:
#   docker run -v ./twitter-cookies.env:/app/twitter-cookies.env:ro ...

AUTH_TOKEN=your_auth_token_here
CT0=your_ct0_token_here
